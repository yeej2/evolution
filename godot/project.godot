; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="EVOLUTION"
config/description="Multiplayer Vertical Slice 0.1 - one forest, one shared ecosystem."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

MutationDB="*res://scripts/autoload/mutation_db.gd"
SpeciesDB="*res://scripts/autoload/species_db.gd"
LineageDB="*res://scripts/autoload/lineage_db.gd"
EventDB="*res://scripts/autoload/event_db.gd"
NetworkManager="*res://scripts/net/network_manager.gd"
GameState="*res://scripts/autoload/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

